	</pageHeader>
	<columnHeader>
		<band height="54" splitType="Stretch">
			<textField>
				<reportElement x="0" y="32" width="555" height="15" uuid="4aed75dd-ec66-4943-bb52-2304190815a1">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="SolaimanLipi" size="8"/>
					<paragraph leftIndent="50"/>
				</textElement>
				<textFieldExpression><![CDATA["(গ) আপনার প্রতিষ্ঠানের গত "+$P{sutroThreeDate}+" ইং তারিখের পত্র নং-"+$P{sutroThreeNo}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="2" width="555" height="15" uuid="e7e1694d-6a34-4194-a183-965228fde226">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="SolaimanLipi" size="8"/>
					<paragraph leftIndent="50"/>
				</textElement>
				<textFieldExpression><![CDATA["সূত্র: (ক) অত্র দপ্তরের স্মারক নং "+$P{sutroOneNo}+"তারিখ: "+$P{sutroOneDate}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="17" width="555" height="15" uuid="8b7c70e0-6088-4451-b9e4-006770933a30">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font fontName="SolaimanLipi" size="8"/>
					<paragraph leftIndent="50"/>
				</textElement>
				<textFieldExpression><![CDATA["(খ) আপনার প্রতিষ্ঠানের গত ইং "+$P{sutroTwoDate}+" তারিখের আবেদন পত্রের সংখ্যা নং-এসইপ/-"+$P{sutroTwoNo}]]></textFieldExpression>
			</textField>
		</band>
	</columnHeader>
	<detail>
		<band height="150" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="554" height="124" uuid="9801aeed-23ad-4f98-994f-0bd3a7b456b6">
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="SolaimanLipi" size="8"/>
					<paragraph leftIndent="50"/>
				</textElement>
				<textFieldExpression><![CDATA["উপযুক্ত বিষয়ে সূত্রস্থ (খ) স্মারকের মাধ্যমে প্রাপ্ত আবেদনের প্রেক্ষিতে নির্দেশক্রমে জানানো যাচ্ছে যে, বাংলাদেশ-ভারত অভ্যন্তরীণ নৌ-পথ অতিক্রম ও বানিজ্য প্রটোকল (PIWT&T)- এর আওতায় বৈধ পণ্য পরিবহনের নিমিত্ত তালিকাভুক্তি/ লাইসেন্সের জন্য সূত্রস্থ (গ) স্মারকের মাধ্যমে জামানত বাবদ "+$P{tkAmount} +" টাকা (ফেরতযোগ্য) এবং এতদসংক্রান্ত বিষয়ে পালনীয় আপনার প্রতিষ্ঠানের অংগীকারনামা (under taken) অত্র দপ্তরে হস্তগত হওয়ায় যথাযথ কর্তৃপক্ষের অনুমোদনক্রমে (PIWT&T)-র আওতায় আপনার নিজস্ব প্রতিষ্ঠান-কে বৈধ পণ্য পরিবহনের নিমিত্ত সময় সময় জারিকৃত এতদসংক্রান্ত নিদের্শনা, দাখিলকৃত অংগীকারনামা প্রতিপালন এবং বার্ষিক নবায়নের শর্তে "+$P{bodyYear} +" সনের জন্য তালিকাভূক্ত করত: উক্ত তালিকাভুক্তি/লাইসেন্সের কার্যাদেশ প্রদান করা হলো। উল্লেখ্য যে, বাংলাদেশ-ভারত অভ্যন্তরীণ নৌ-পথ অতিক্রমণ ও বানিজ্য প্রটোকল (PIWT&T)-এর আওতায় সকল বিধি বিধান ও পণ্য পরিবহন পদ্ধতি (কপি সংযুক্ত) এবং আপনার প্রতিষ্ঠানের দাখিলকৃত অংগীকারনামা যথাযথ প্রতিপালনে ব্যর্থ হলে আপনার প্রতিষ্ঠানের তালিকাভূক্তি স্থগিত/বাতিল করার ক্ষমতা এত্র কর্তৃপক্ষের নিকট সংরক্ষিত থাকবে ।"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="50" y="124" width="160" height="26" uuid="75828df2-2ae4-4826-9051-1cf73a33d136"/>
				<textElement verticalAlignment="Middle">
					<font fontName="SolaimanLipi" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[সংযুক্ত:বর্ণানামতে (একটা নির্দেশিকা)।]]></text>
			</staticText>
		</band>
	</detail>
	<summary>
