				</textElement>
				<text><![CDATA[উপ- পরিচালক (বৈ.পরি)
]]></text>
			</staticText>
			<staticText>
				<reportElement x="380" y="41" width="150" height="15" uuid="013b9457-03d8-4f8b-9de0-49358e6265fc">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SolaimanLipi" size="8"/>
				</textElement>
				<text><![CDATA[নৌ-নিরাপত্তা ও ট্রাফিক বিভাগ, ঢাকা।
]]></text>
			</staticText>
			<staticText>
				<reportElement x="380" y="56" width="150" height="15" uuid="4718444b-5b90-4197-b9a7-1e08cb0a57d6">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SolaimanLipi" size="8"/>
				</textElement>
				<text><![CDATA[ফোন: ৯৫৮৬১০৭
]]></text>
			</staticText>
			<staticText>
				<reportElement x="380" y="71" width="150" height="15" uuid="851d7495-8dd6-47e4-ba4f-f6ac89092a0b">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SolaimanLipi" size="8"/>
				</textElement>
				<text><![CDATA[Email- protocolbiwta@gmail.com ]]></text>
			</staticText>
			<staticText>
				<reportElement x="51" y="90" width="504" height="15" uuid="fd06512d-ee34-4d13-9006-d852982cd0ab">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="SolaimanLipi" size="8"/>
				</textElement>
				<text><![CDATA[১। সমন্বয় কর্মকর্তা, চেয়ারম্যান মহোদয় দপ্তর, বাঅনৌপক,ঢাকা।]]></text>
			</staticText>
			<staticText>
				<reportElement x="51" y="105" width="504" height="15" uuid="4dcc3cfa-d327-4518-b191-5f4c9f452198">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="SolaimanLipi" size="8"/>
				</textElement>
				<text><![CDATA[২। সদস্য (পরিকল্পনা ও পরিচালন) মহোদয়ের ব্যক্তিগত সহকারী,বাঅনৌপক,ঢাকা।]]></text>
			</staticText>
			<staticText>
				<reportElement x="51" y="135" width="504" height="15" uuid="2431129a-4a48-4c81-a015-64e827183e2f">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="SolaimanLipi" size="8"/>
				</textElement>
				<text><![CDATA[৪। পরিচালক (হিসাব) মহোদয়ের ব্যক্তিগত সহকারী,বাঅনৌপক,ঢাকা।]]></text>
			</staticText>
			<staticText>
				<reportElement x="51" y="120" width="504" height="15" uuid="cbe290e2-a2e1-4fa0-92f7-75e99df86c5a">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="SolaimanLipi" size="8"/>
				</textElement>
				<text><![CDATA[৩। সদস্য (অর্থ) মহোদয়ের ব্যক্তিগত সহকারী,বাঅনৌপক,ঢাকা।]]></text>
			</staticText>
			<staticText>
				<reportElement x="51" y="180" width="504" height="15" uuid="9f20bb85-2ab7-4735-93e0-5ad4caba2d86">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="SolaimanLipi" size="8"/>
				</textElement>
				<text><![CDATA[৭। অফিস কপি।]]></text>
			</staticText>
			<staticText>
				<reportElement x="51" y="150" width="504" height="15" uuid="8410fef4-6809-467f-ae62-d70a8b493bde">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="SolaimanLipi" size="8"/>
				</textElement>
				<text><![CDATA[৫। পরিচালক, (নৌ-নিট্রা) মহোদয়ের ব্যক্তিগত সহকারী,বাঅনৌপক,ঢাকা।]]></text>
			</staticText>
			<staticText>
				<reportElement x="51" y="165" width="504" height="15" uuid="5f90c13a-1332-4b6b-9e68-00e4202cfc3b">
