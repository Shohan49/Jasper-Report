			<staticText>
				<reportElement mode="Opaque" x="2070" y="20" width="80" height="20" backcolor="#FFE8FB" uuid="64176b81-b7fe-40e7-a811-e7d15dc77b08"/>
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
