	<columnHeader>
		<band height="45" splitType="Stretch">
			<textField>
				<reportElement x="0" y="5" width="572" height="20" uuid="e7e1694d-6a34-4194-a183-965228fde226">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
					<paragraph leftIndent="50"/>
				</textElement>
				<textFieldExpression><![CDATA["Ref: (1) Your Application no. WS/BIWTA Date: "+$P{sutroOneDate}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="25" width="572" height="20" uuid="8b7c70e0-6088-4451-b9e4-006770933a30">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
					<paragraph leftIndent="72"/>
				</textElement>
				<textFieldExpression><![CDATA["(2) IWAI Permission no."+$P{iwaiPermissionNo} +" Dated:"+$P{sutroTwoDate}]]></textFieldExpression>
			</textField>
		</band>
	</columnHeader>
	<detail>
		<band height="502" splitType="Stretch">
			<textField>
				<reportElement x="0" y="6" width="572" height="60" uuid="9801aeed-23ad-4f98-994f-0bd3a7b456b6">
					<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="DejaVu Sans" size="10" isItalic="false"/>
					<paragraph leftIndent="50"/>
				</textElement>
				<textFieldExpression><![CDATA["Voyage permission is hereby accorded in favour of your empty fleet named  " + $P{vesselName} + " under the guidance of Mr. Habibul Molla Master Class-2 Certificate No. 399 Permitted to proceed for " + $P{destination}+ " from " + $P{portofSailing}+ " ( Via "+$P{nextPort}+ ") through protocol under the particulars & conditions as follows: -"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="50" y="66" width="130" height="15" uuid="4540c7f2-41fc-40c0-8a4d-99da7bd97788">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box>
					<bottomPen lineWidth="1.0" lineStyle="Solid"/>
				</box>
				<textElement>
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<text><![CDATA[01.    Port of Sailing               ]]></text>
			</staticText>
			<staticText>
				<reportElement x="227" y="66" width="130" height="15" uuid="2b9d249e-258b-44a3-98ba-dfb7097e1798">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box>
					<bottomPen lineWidth="1.0" lineStyle="Solid"/>
				</box>
				<textElement textAlignment="Center">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<text><![CDATA[Next Port of Call]]></text>
			</staticText>
			<staticText>
				<reportElement x="410" y="66" width="145" height="15" uuid="c4cd2f34-1d12-46f2-897a-ac481611df55">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box>
					<bottomPen lineWidth="1.0" lineStyle="Solid"/>
				</box>
				<textElement textAlignment="Center">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<text><![CDATA[Ultimate port of Destination]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="50" y="81" width="130" height="15" uuid="505462cb-00be-4187-b662-db02a3869073">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{portofSailing}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="227" y="81" width="130" height="15" uuid="d9245b0f-e8e7-491c-a4b5-520e16fce9aa">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{nextPort}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="410" y="81" width="145" height="15" uuid="1f3c609f-69a9-48e6-9530-e3a25235ba9f">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{destination}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="50" y="104" width="522" height="18" uuid="c737e1c9-c692-4d43-b244-423b1fc6af0d">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["02. Nature of Cargo: "+$P{natureofCargo}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="50" y="122" width="522" height="18" uuid="8df557b6-1ed6-44dd-811f-d176875bae68">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["03. Validity period of this permission: From "+$P{fromDate}+" To "+$P{toDate}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="50" y="140" width="522" height="18" uuid="3f015f35-2d5b-44b2-8c21-1a3c3964ce15">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["04. IWAI shall have to observe all Customs/Immigration formalities under the Acts now enforce."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="50" y="158" width="522" height="18" uuid="949f6c26-67f0-47e8-8059-0ec24c2e2a29">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["05. IWAI shall have to observe all Customs/Immigration formalities under the Acts now enforce."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="50" y="176" width="522" height="28" uuid="0344c637-ee1e-48aa-a4dc-7a5468392097">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["06. The vessel having highest 2.35 Meter loaded draft (As per River notice published on 07/05/2024 by C&P Dept.) will have to run through Saheber Agla-chilmari-sirajganj-paturia-channel during day light."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="50" y="204" width="522" height="28" uuid="7aa23946-aa91-40ef-8285-807550d5f8e6">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["07. The vessel will have to run through Mongla- Ghashiakhali channel in one way system during day light with full tide water."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="50" y="232" width="522" height="28" uuid="1cdf139a-7a2d-4b4e-a087-2604b76dc628">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["08. The vessel shall ensure to avoid any collision with the deployed dredger or dredging equipment while acrossing Mongla- Ghashiakhali channel."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="50" y="260" width="522" height="28" uuid="c5b2b84d-365d-4fd6-96dc-c3baf482a63b">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["09. IWAI shall have submitted their report to the concerned custom authority within seven days from the date of completion of the voyage. "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="50" y="316" width="522" height="28" uuid="20cf1b67-56ef-4a12-80af-b73510248ead">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["11. The vessel/Operator should ensure that the vessel ply under the guidance of the trained pilot when the vessel is in Bangladesh Territory."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="50" y="288" width="522" height="28" uuid="56d54f18-549d-4600-ba54-4807594c31f6"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["10. Original copies of survey certificate and draft chart shall have to be displayed on board the vessel in such manner as any authority may examine those documents at any time."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="50" y="344" width="522" height="18" uuid="4ff5ef52-75ce-4302-b766-9d067db7c7e0">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["12. VHF set of the vessel should always be on-air and on contact with the nearest vessel."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="50" y="400" width="522" height="28" uuid="9e661c5c-b040-486c-8556-f6d629ffd401">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["14. The operator will have to adhere all provisions of the inland shipping ordinance 1976 and circulars order issued by the concerned authorities from time to time."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="50" y="362" width="522" height="38" uuid="1c4fd602-9eca-4bbc-9e44-4bba5155d3bc">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["13. The vessel operator/shipping agent shall comply with the standard operating procedure (sop) issued by Inland Waterways Authority of India (IWAI) vide memo no. IWAI/KOL/PROT/ 2018-19 dated April 28th 2020 while the vessel is in Bangladesh Territory."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="50" y="446" width="522" height="28" uuid="7d86b36f-85db-46ba-8ae2-6aafbee9c713">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["16. In the event of extension / amendment of this permission the proposal must be submitted two days prior to expiry of this permission."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="49" y="474" width="523" height="28" uuid="bd10788e-cabd-431a-bd6b-3af4353d8bd5">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["17. The vessel must adhere to the safely regulations related to navigational Width & Draft of the designed route and comply with the instructions from the pilot onboard.."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="50" y="428" width="522" height="18" uuid="ff98eeba-494f-41bf-ab9c-008a34b34e16">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["15. All provision of the protocol on Inland Water Transit & Trade between Bangladesh and India will be effective."]]></textFieldExpression>
			</textField>
		</band>
	</detail>
