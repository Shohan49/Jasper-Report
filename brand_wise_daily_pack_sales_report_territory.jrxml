	<variable name="teamCount_division_group" class="java.lang.Integer" resetType="Group" resetGroup="Division_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{teamCount}]]></variableExpression>
	</variable>
	<variable name="tms_count_division_group" class="java.lang.Integer" resetType="Group" resetGroup="Division_Group" calculation="Sum">
