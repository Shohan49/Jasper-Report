<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio version 6.18.1.final using JasperReports Library version 6.18.1-9d75d1969e774d4f179fb3be8401e98a0e6d1611  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="consumer_contact_daily_report_all_brand" pageWidth="3750" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8d35e38d-4207-4109-bf5c-49dc0d187cc9">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PRODUCTION_AKT_TMA"/>
	<parameter name="targetDate" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
            ROW_NUMBER() over (order by division.id) as serial,
            wing.id as wingId,
            wing.teritory_name as wingName,
            division.id as divisionId,
            division.teritory_name as divisionName,
            ter.id AS territoryID,
            ter.TERITORY_NAME territoryName,
            sum(nvl(targetValue.teamCount, 0)) as teamCount,
            sum(nvl(targetValue.tmsAttendanceCount, 0)) as tmsAttendanceCount,
            sum(nvl(targetValue.tmrAttendanceCount, 0)) as tmrAttendanceCount,
            sum(nvl(targetValue.baAttendanceCount, 0)) as baAttendanceCount,
            --sum(nvl(targetValue.targetContact, 0)) as targetContact,
            --sum(nvl(targetValue.targetFreeSample, 0)) as targetFreeSample,
            sum(nvl(targetValue.targetPacksales, 0)) as packSalesTarget,
            sum(nvl(targetValue.targetVaoSales, 0)) as vaoSalesTarget,
            sum(nvl(actualSales.rallyVerveSales, 0)) as rallyVerveSales,
            sum(nvl(actualSales.rallyIceSales, 0)) as rallyIceSales,
            sum(nvl(actualSales.rallyBoltSales, 0)) as rallyBoltSales,
            sum(nvl(actualSales.mariseSales, 0)) as mariseSale,
            sum(nvl(actualSales.smtbSales, 0)) as smtbSales,
            sum(nvl(actualSales.smabSales, 0)) as smabSales,
            sum(nvl(actualSales.smbbSales, 0)) as smbbSales,
            sum(nvl(actualSales.rallyVaoSales, 0)) as rallyVaoSales,
            sum(nvl(actualSales.mariseVaoSales, 0)) as mariseVaoSales,
            sum(nvl(actualSales.sunmoonVaoSales, 0)) as sunmoonVaoSales,
            sum(nvl(actualSales.vaoSalesPerson, 0)) as vaoSalesPerson,
            sum(nvl(actualSales.vaoSales, 0)) as vaoSales,
            sum(nvl(actualSales.packetSalesPerson, 0)) as packetSalesPerson,
            sum(nvl(actualSales.packetSalesQty, 0)) as packetSalesQty,
            sum(nvl(actualSales.visitedOutlet, 0)) as visitedOutlet,
            sum(ri_Bundle) riBundle,
            (CASE WHEN sum(raTotalBundle) != 0 then (sum(ri_bundle)/sum(raTotalBundle)*100) ELSE 0 END) riContribution,
           sum(rbBundle) rbBundle,
           (CASE WHEN sum(raTotalBundle) != 0 then (sum(rbBundle)/sum(raTotalBundle)*100) ELSE 0 END)  rbContribution,
           sum(RallyTargetBundle) rallyTargetBundle,
           sum(raTotalBundle) raTotalBundle,
           sum(smaBundle) smaBundle,
           (CASE WHEN sum(smTotalBundle) != 0 then (sum(smaBundle)/sum(smTotalBundle)*100) ELSE 0 END) smaContribution,
           sum(smtBundle) smtBundle,
           (CASE WHEN sum(smTotalBundle) != 0 then (sum(smtBundle)/sum(smTotalBundle)*100) ELSE 0 END)  smtContribution,
           sum(smbBundle) smbBundle,
           (CASE WHEN sum(smTotalBundle) != 0 then (sum(smbBundle)/sum(smTotalBundle)*100) ELSE 0 END)  smbContribution,
           sum(SunmoonTargetBundle) sunmoonTargetBundle,
           sum(smTotalBundle) smTotalBundle,
           sum(RallyTargetBundle+SunmoonTargetBundle) grandTotalBundleTarget, 
           sum(grandTotalBundle) grandTotalBundle
            from (select distinct ter.id as territoryId,
                count (distinct teamWiseData.team_id) as teamCount,
                sum(teamWiseData.tmsAttendanceCount) as tmsAttendanceCount,
                sum(teamWiseData.tmrAttendanceCount) as tmrAttendanceCount,
                sum(teamWiseData.baAttendanceCount) as baAttendanceCount,
                sum(teamWiseData.targetContact) as targetContact,
                sum(teamWiseData.targetFreeSample) as targetFreeSample,
                sum(teamWiseData.targetPacksales) as targetPacksales,
                sum(teamWiseData.targetVaoSales) as targetVaoSales,
                sum(teamWiseData.RallyTargetBundle) as RallyTargetBundle,
                sum(teamWiseData.SunmoonTargetBundle) as SunmoonTargetBundle
            from (select distinct brTeam.team_id,
                                sum(case when role.role = 'TMS' then 1 else 0 end) tmsAttendanceCount,
                                sum(case when role.role = 'TMR' then 1 else 0 end) tmrAttendanceCount,
                                sum(case when role.role = 'BA' then 1 else 0 end) baAttendanceCount,
                                sum(case when role.role = 'TMR' or role.role = 'BA' then 1 else 0 end) * teamtarget.contact_limit as targetContact,
                                sum(case when role.role = 'TMR' or role.role = 'BA' then 1 else 0 end) * teamtarget.contact_limit  * 3 as targetFreeSample,
                                sum(case when role.role = 'TMR' or role.role = 'BA' then 1 else 0 end) * teamtarget.packet_sales_target as targetPacksales,
                                sum(case when role.role = 'TMR' or role.role = 'BA' then 1 else 0 end) * teamtarget.vao_sales_quantity as targetVaoSales,
                                sum(case when role.role = 'TMR' or role.role = 'BA' then 1 else 0 end) * teamtarget.rally_bundle_target as RallyTargetBundle,
  								sum(case when role.role = 'TMR' or role.role = 'BA' then 1 else 0 end) * teamtarget.sunmoon_bundle_target as SunmoonTargetBundle
                            from appsm.bruser_attendance brUserAttendance
                                inner join appsm.bruser on (bruserattendance.br_user_user_id = bruser.user_id and to_char(bruserattendance.attendance_date_time, 'dd-mm-yyyy') = $P{targetDate})
                                inner join appsm.bruser_roles userRoles on (bruser.user_id = userRoles.bruser_user_id)
                                inner join appsm.role role on (userRoles.roles_id = role.id)
                                inner join appsm.br_user_team brUserTeam on (bruser.user_id = bruserteam.br_user_id and to_date($P{targetDate}, 'dd-mm-yyyy') > brUserTeam.ed and to_date($P{targetDate}, 'dd-mm-yyyy') <= bruserteam.td)
                                inner join appsm.brteam brTeam on (brUserteam.br_team_id = brteam.team_id)
                                inner join (
                                select 
                                    distinct targetList.br_team_id as br_team_id,
                                    sum(targetList.contact_limit) as contact_limit,
                                    sum(targetList.packet_sales_target) as packet_sales_target,
                                    sum(targetList.vao_sales_quantity) as vao_sales_quantity,
                                    sum(targetList.rally_bundle_target) AS rally_bundle_target,
                                    sum(targetList.sunmoon_bundle_target) AS sunmoon_bundle_target
                                from  (select 
                                        ab.br_team_id, 
                                        max(ab.contact_limit) contact_limit, 
                                        max(distinct ab.contact_module) contact_module, 
                                        max(distinct ab.combined_contact_module) combined_contact_module,  
                                        max(case when ab.product_id in (1, 2, 11, 12, 13, 14) then bbst.BUNDLE_SALES_TARGET else 0 end ) as rally_bundle_target,
       									max(case when ab.product_id in (15, 16, 17, 18, 19, 20) then bbst.BUNDLE_SALES_TARGET else 0 end)  as sunmoon_bundle_target,
                                        bpst.packet_sales_target,
                                        bvst.vao_sales_quantity
                                    from appsm.assign_brand ab 
                                    left join appsm.br_packet_sales_target bpst 
                                    on(ab.contact_module = bpst.contact_module and nvl(ab.combined_contact_module, 0) = nvl(bpst.combined_contact_module, 0) and to_date($P{targetDate}, 'dd-mm-yyyy') > bpst.ed and  to_date($P{targetDate}, 'dd-mm-yyyy') <= bpst.td)
                                    left join appsm.br_vao_sales_target bvst 
                                    on(ab.contact_module = bvst.contact_module and nvl(ab.combined_contact_module, 0) = nvl(bvst.combined_contact_module, 0) and to_date($P{targetDate}, 'dd-mm-yyyy') > bvst.ed  and to_date($P{targetDate}, 'dd-mm-yyyy') <= bvst.td)
                                    LEFT JOIN appsm.BR_BUNDLE_SALES_TARGET bbst on(ab.contact_module = bbst.contact_module and nvl(ab.combined_contact_module, 0) = nvl(bbst.combined_contact_module, 0) and to_date($P{targetDate}, 'dd-mm-yy') >  bbst.ed and to_date($P{targetDate}, 'dd-mm-yy') <= bbst.td)
                                    where to_char(ab.target_date, 'dd-mm-yyyy') = $P{targetDate}
                                    group by ab.contact_module, ab.combined_contact_module, ab.br_team_id, bpst.packet_sales_target, bvst.vao_sales_quantity) targetList
                                group by targetList.br_team_id) teamTarget on (teamtarget.br_team_id = brteam.team_id)
                            group by brTeam.team_id, teamtarget.contact_limit, teamtarget.packet_sales_target, teamtarget.vao_sales_quantity, teamtarget.rally_bundle_target, teamtarget.sunmoon_bundle_target) teamWiseData 
            inner join appsm.brteam brTeam on (teamWiseData.team_id = brteam.team_id)
            inner join appsm.teritory ter on (brteam.teritory_id = ter.id)
            group by ter.id ) targetValue left join
            (select 
                vter.teritory_id as territory_id,
                
                -----------<Packet sales count pre person>-----------
                sum(case when bract.packet_sales_brand is not null and bract.sales_pack_qty > 0 and  bract.packet_sales_brand in (1,2) then 1 else 0 end ) rallyVerveSales,
                sum(case when bract.packet_sales_brand is not null and bract.sales_pack_qty > 0 and  bract.packet_sales_brand in (11,12) then 1 else 0 end ) rallyIceSales,
                sum(case when bract.packet_sales_brand is not null and bract.sales_pack_qty > 0 and  bract.packet_sales_brand in (13,14) then 1 else 0 end ) rallyBoltSales,
                sum(case when bract.packet_sales_brand is not null and bract.sales_pack_qty > 0 and  bract.packet_sales_brand in (4,5) then 1 else 0 end ) mariseSales,
                sum(case when bract.packet_sales_brand is not null and bract.sales_pack_qty > 0 and  bract.packet_sales_brand in (18,19) then 1 else 0 end ) smtbSales,
                sum(case when bract.packet_sales_brand is not null and bract.sales_pack_qty > 0 and  bract.packet_sales_brand in (16,17) then 1 else 0 end ) smabSales,
                sum(case when bract.packet_sales_brand is not null and bract.sales_pack_qty > 0 and  bract.packet_sales_brand in (20,21) then 1 else 0 end ) smbbSales,
            
            
                -----------<Vao sales count pre person>-----------
                sum(case when bract.vao_sales_brand is not null and bract.vao_sales_pack > 0 and bract.vao_sales_brand in (1,2,11,12,13,14) then 1 else 0 end ) rallyVaoSales,
                sum(case when bract.vao_sales_brand is not null and bract.vao_sales_pack > 0 and bract.vao_sales_brand in (4,5) then 1 else 0 end ) mariseVaoSales,
                sum(case when bract.vao_sales_brand is not null and bract.vao_sales_pack > 0 and bract.vao_sales_brand in (16,17,18,19,20,21) then 1 else 0 end ) sunmoonVaoSales,
            
                ----------<Total vao sales person>--------
                sum(case when bract.vao_sales_brand is not null and bract.vao_sales_pack > 0 then 1 else 0 end) as vaoSalesPerson,
                
                ----------<Total vao sales pack>------------
                sum(bract.vao_sales_pack) as vaoSales,
                
                ----------<Total pack sales person>--------
                sum(case when bract.packet_sales_brand is not null and bract.sales_pack_qty > 0 then 1 else 0 end) as packetSalesPerson,
                
                ----------<Total sales pack>--------
                sum(case when bract.packet_sales_brand is not null and bract.sales_pack_qty > 0 then bract.sales_pack_qty else 0 end) as packetSalesQty,
                
                ----------<Total outlet visit>--------
                count(distinct bract.outlet_id) as visitedOutlet,
                sum(CASE WHEN bract.BUNDLE_PRODUCT_ID IN (11,12) THEN 1 ELSE 0 END) ri_Bundle,
           sum(CASE WHEN bract.BUNDLE_PRODUCT_ID IN (13,14) THEN 1 ELSE 0 END) rbBundle,
           sum(CASE WHEN bract.BUNDLE_PRODUCT_ID IN (11,12,13,14) THEN 1 ELSE 0 END) raTotalBundle,
           sum(CASE WHEN bract.BUNDLE_PRODUCT_ID IN (16,17) THEN 1 ELSE 0 END) smaBundle,
           sum(CASE WHEN bract.BUNDLE_PRODUCT_ID IN(18,19) THEN 1 ELSE 0 END) smtBundle,
           sum(CASE WHEN bract.BUNDLE_PRODUCT_ID IN (20,21)THEN 1 ELSE 0 END) smbBundle,
           sum(CASE WHEN bract.BUNDLE_PRODUCT_ID IN (16,17,18,19,20,21)THEN 1 ELSE 0 END) smTotalBundle,
           sum(CASE WHEN bract.BUNDLE_PRODUCT_ID IN (11,12,13,14,16,17,18,19,20,21) THEN 1 ELSE 0 END) grandTotalBundle
                
            from appsm.bractivity bract
            inner join appsm.v_teritory_all vter on (bract.route_id = vter.route_id)
            where to_char(bract.target_date, 'dd-mm-yyyy') = $P{targetDate}
            group by vter.teritory_id) actualSales on (targetValue.territoryId = actualSales.territory_id)
            inner join appsm.teritory ter on (actualSales.territory_id = ter.id)
            inner join appsm.teritory division on (ter.parent_id = division.id)
            inner join appsm.teritory wing on (division.parent_id = wing.id)
            group by division.id, division.teritory_name, wing.id, wing.teritory_name, ter.id, ter.teritory_name
            order by division.id, ter.id]]>
	</queryString>
	<field name="serial" class="java.lang.Integer"/>
