	<variable name="ba_count_division_group" class="java.lang.Integer" resetType="Group" resetGroup="Division_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{baAttendanceCount}]]></variableExpression>
	</variable>
	<variable name="rally_verve_sale_count_division_group" class="java.lang.Integer" resetType="Group" resetGroup="Division_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{rallyVerveSales}]]></variableExpression>
	</variable>
	<variable name="rally_ice_sale_count_division_group" class="java.lang.Integer" resetType="Group" resetGroup="Division_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{rallyIceSales}]]></variableExpression>
	</variable>
	<variable name="rally_bolt_sale_count_division_group" class="java.lang.Integer" resetType="Group" resetGroup="Division_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{rallyBoltSales}]]></variableExpression>
	</variable>
	<variable name="marise_sale_count_division_group" class="java.lang.Integer" resetType="Group" resetGroup="Division_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{mariseSale}]]></variableExpression>
	</variable>
	<variable name="smtb_sale_count_division_group" class="java.lang.Integer" resetType="Group" resetGroup="Division_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{smtbSales}]]></variableExpression>
	</variable>
	<variable name="smab_sale_count_division_group" class="java.lang.Integer" resetType="Group" resetGroup="Division_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{smabSales}]]></variableExpression>
	</variable>
	<variable name="smbb_sale_count_division_group" class="java.lang.Integer" resetType="Group" resetGroup="Division_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{smbbSales}]]></variableExpression>
	</variable>
	<variable name="vao_sale_sum_rally_division_group" class="java.lang.Integer" resetType="Group" resetGroup="Division_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{rallyVaoSales}]]></variableExpression>
	</variable>
	<variable name="vao_sale_sum_marise_division_group" class="java.lang.Integer" resetType="Group" resetGroup="Division_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{mariseVaoSales}]]></variableExpression>
	</variable>
	<variable name="vao_sale_sum_sunmoon_division_group" class="java.lang.Integer" resetType="Group" resetGroup="Division_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{sunmoonVaoSales}]]></variableExpression>
	</variable>
	<variable name="packet_sales_target_sum_division_group" class="java.lang.Integer" resetType="Group" resetGroup="Division_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{packSalesTarget}]]></variableExpression>
	</variable>
	<variable name="packet_sales_actual_sum_division_group" class="java.lang.Integer" resetType="Group" resetGroup="Division_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{packetSalesPerson}]]></variableExpression>
	</variable>
	<variable name="vao_sales_target_sum_division_group" class="java.lang.Long" resetType="Group" resetGroup="Division_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{vaoSalesTarget}]]></variableExpression>
	</variable>
	<variable name="vao_sales_actual_sum_division_group" class="java.lang.Long" resetType="Group" resetGroup="Division_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{vaoSalesPerson}]]></variableExpression>
	</variable>
	<variable name="vao_sales_and_packet_sale_target_sum_division_group" class="java.lang.Integer" resetType="Group" resetGroup="Division_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{packSalesTarget} + $F{vaoSalesTarget}]]></variableExpression>
	</variable>
	<variable name="vao_sales_and_packet_sale_actual_sum_division_group" class="java.lang.Integer" resetType="Group" resetGroup="Division_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{packetSalesPerson} + $F{vaoSalesPerson}]]></variableExpression>
	</variable>
	<variable name="v_ice_sales" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{riBundle}]]></variableExpression>
	</variable>
	<variable name="v_bolt_sales" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{rbBundle}]]></variableExpression>
	</variable>
	<variable name="v_rally_total_target" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{rallyTargetBundle}]]></variableExpression>
	</variable>
	<variable name="v_rally_total_sales" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{raTotalBundle}]]></variableExpression>
	</variable>
	<variable name="v_a_sales" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{smaBundle}]]></variableExpression>
	</variable>
	<variable name="v_t_sales" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{smtBundle}]]></variableExpression>
	</variable>
	<variable name="v_b_sales" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{smbBundle}]]></variableExpression>
	</variable>
	<variable name="v_sun_total_target" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{sunmoonTargetBundle}]]></variableExpression>
	</variable>
	<variable name="v_sun_total_sales" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{smTotalBundle}]]></variableExpression>
	</variable>
	<variable name="v_grand total_Rally+Sunm_target" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{grandTotalBundleTarget}]]></variableExpression>
	</variable>
	<variable name="v_grand total_Rally+Sunm_sales" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{grandTotalBundle}]]></variableExpression>
	</variable>
	<variable name="v_ice_con" class="java.lang.Double"/>
	<variable name="v_bolt_con" class="java.lang.Double"/>
	<variable name="v_a_con" class="java.lang.Double"/>
	<variable name="v_t_con" class="java.lang.Double"/>
	<variable name="v_b_con" class="java.lang.Double"/>
	<group name="Division_Group">
		<groupExpression><![CDATA[$F{divisionId}]]></groupExpression>
		<groupFooter>
			<band height="20">
				<textField>
					<reportElement mode="Opaque" x="80" y="0" width="150" height="20" backcolor="#99FFCC" uuid="234fb048-e913-433b-9d7f-4a621c2f61be"/>
					<box>
						<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$F{divisionName}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement mode="Opaque" x="230" y="0" width="80" height="20" backcolor="#99FFCC" uuid="828fe938-6005-441d-9962-fbebbacbfe6d"/>
					<box>
						<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$V{teamCount_division_group}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement mode="Opaque" x="390" y="0" width="80" height="20" backcolor="#99FFCC" uuid="08ed712b-e631-4cad-9012-d42a8b43f4f1"/>
