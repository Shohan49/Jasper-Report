	<field name="smaBundle" class="java.lang.Long"/>
	<field name="smtBundle" class="java.lang.Long"/>
	<field name="smbBundle" class="java.lang.Long"/>
	<field name="sunmoonTargetBundle" class="java.lang.Long"/>
