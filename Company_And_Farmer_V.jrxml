				</textElement>
				<text><![CDATA[চাষীর স্বাক্ষর]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="643" width="220" height="37" uuid="57fb991e-963d-4e47-930c-d32cdeba1113"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SolaimanLipi"/>
				</textElement>
				<text><![CDATA[আমি উপরের শর্তাবলী সুস্থ মস্তিস্কে পড়ে/শুনে এবং সম্পূর্ণরূপে মেনে নিয়ে স্বাক্ষর/টিপসই করে মূল কপি গ্রহণ করলাম।]]></text>
			</staticText>
